{
    "name": "vannevarcode",
    "displayName": "Vannevar Code",
    "description": "Per-tab API provider switching for the Claude Code extension: Anthropic, DeepSeek, OpenAI, Gemini, OpenRouter, Ollama, a ChatGPT subscription — switched from the command menu, per tab.",
    "publisher": "beatlejute",
    "version": "2.1.296",
    "verifiedAgainst": ["2.1.296", "2.1.294", "2.1.293", "2.1.292", "2.1.291", "2.1.289", "2.1.288", "2.1.287", "2.1.286", "2.1.285", "2.1.284", "2.1.283", "2.1.282", "2.1.280", "2.1.278", "2.1.276", "2.1.274"],
    "license": "MIT",
    "icon": "images/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/beatlejute/VannevarCode"
    },
    "bugs": {
        "url": "https://github.com/beatlejute/VannevarCode/issues"
    },
    "engines": {
        "vscode": "^1.85.0",
        "node": ">=18"
    },
    "extensionKind": ["workspace", "ui"],
    "activationEvents": ["onStartupFinished"],
    "main": "./extension.js",
    "categories": ["Other"],
    "keywords": ["claude-code", "provider", "openai", "gemini", "deepseek", "proxy"],
    "contributes": {
        "commands": [
            { "command": "vannevar.applyPatch", "title": "Vannevar: Apply patch to Claude Code" },
            { "command": "vannevar.revertPatch", "title": "Vannevar: Revert patch (restore Claude Code)" },
            { "command": "vannevar.status", "title": "Vannevar: Patch status" },
            { "command": "vannevar.showLog", "title": "Vannevar: Show log" },
            { "command": "vannevar.openProfiles", "title": "Vannevar: Open profiles folder" },
            { "command": "vannevar.installMcp", "title": "Vannevar: Register the delegated-agent MCP server" },
            { "command": "vannevar.loginChatgpt", "title": "Vannevar: Sign in to ChatGPT (subscription mode)" },
            { "command": "vannevar.panicRestore", "title": "Vannevar: Panic restore / Safe mode" }
        ],
        "configuration": {
            "title": "Vannevar Code",
            "properties": {
                "vannevar.autoPatch": {
                    "type": "boolean",
                    "default": true,
                    "description": "Re-apply the patch by itself after a Claude Code update."
                },
                "vannevar.progress.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable progress tracking and analytics."
                },
                "vannevar.progress.semantic": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable semantic progress analysis."
                },
                "vannevar.progress.channels": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable progress channels for fine-grained tracking."
                },
                "vannevar.progress.nativeSemantic": {
                    "type": "boolean",
                    "default": true,
                    "description": "Use native semantic understanding for progress analysis."
                },
                "vannevar.progress.expandedView": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable expanded view of progress details."
                },
                "vannevar.progress.debug": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable debug mode for progress tracking."
                },
                "vannevar.channels.responseBudget": {
                    "type": "number",
                    "default": 3500,
                    "minimum": 500,
                    "maximum": 16000,
                    "description": "Response budget limit for channel processing."
                }
            }
        }
    },
    "dependencies": {
        "@babel/parser": "^7.28.5",
        "@babel/traverse": "^7.28.5"
    },
    "scripts": {
        "apply": "node runtime/apply-patch.mjs",
        "status": "node runtime/apply-patch.mjs --status",
        "revert": "node runtime/apply-patch.mjs --revert",
        "package": "node scripts/build-vsix.mjs",
        "favicons": "node scripts/fetch-favicons.mjs && node scripts/ico-to-png.mjs && node scripts/shrink-icons.mjs",
        "icons:shrink": "node scripts/shrink-icons.mjs",
        "diag": "node --use-env-proxy scripts/diag-proxy.mjs",
        "proxy": "node --use-env-proxy runtime/proxy/server.mjs",
        "login:chatgpt": "node --use-env-proxy runtime/login-chatgpt.mjs",
        "auth:status": "node runtime/login-chatgpt.mjs --status",
        "test": "node scripts/run-tests.mjs"
    }
}
